ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/sre-copilot.db
UI_BUILD_DIR=ui/dist
RUNBOOKS_DIR=runbooks
SANDBOX_STATE_PATH=sandbox/runtime/state.json
LLM_MODE=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
MAX_STEPS=12
MAX_TOOL_CALLS=24
TOOL_TIMEOUT_SECONDS=20
CORS_ALLOW_ORIGINS=http://localhost:5173
AUTH_ENABLED=false
AUTH_TOKENS={}
AUTH_COOKIE_SECURE=false
SESSION_TTL_SECONDS=3600
ALLOWED_SERVICES=["demo-api"]
ALLOWED_TOOLS=["inspect_demo_service","read_demo_logs","search_runbooks","search_knowledge","http_healthcheck","list_containers","get_container_logs","restore_demo_service","restart_container"]
ALLOWED_HTTP_ORIGINS=[]
ALLOWED_MODEL_ORIGINS=["http://127.0.0.1:11434","http://localhost:11434","http://host.docker.internal:11434"]
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_MAX_DOCUMENTS=2000
KNOWLEDGE_CHUNK_SIZE=1800
